NODE_ENV=production
APP_BASE_URL=https://your-host-domain.example
SERVER_PORT=3000
DATABASE_PATH=./data/modubot.sqlite
# Total concurrent bot processes supported by the real hosting plan, across all users.
# Keep this at the verified capacity; premium tiers reserve up to 25 slots per user.
MAX_HOSTED_BOTS=1

# Discord OAuth2 application (same application as the private platform bot)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
PLATFORM_BOT_TOKEN=
# Salon privé de réception des événements du site et paiements
DISCORD_LOG_CHANNEL_ID=1563843691326476450
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
ADMIN_ACCESS_CODE=

# PayPal Checkout API (leave blank to use the manually verified PayPal.Me flow)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ME_URL=https://paypal.me/FCSTslyz
PAYMENTS_ENABLED=false
